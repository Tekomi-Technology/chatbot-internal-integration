DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chatbot_dashboard?schema=public"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
ENCRYPTION_KEY=""
DIFY_API_BASE_URL="https://dify.noi-bo.example.com/v1"
APP_URL="http://localhost:3000"
WIDGET_RATE_LIMIT="20"
WIDGET_RATE_LIMIT_WINDOW_MS="60000"
ENABLE_CONVERSATION_LOG="false"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="123@12a"

# --- docker compose (tuỳ chọn) ---
# Chỉ ảnh hưởng khi chạy bằng docker compose; xem mục "Docker" trong README.
# Trong container DATABASE_URL luôn bị ghi đè để trỏ tới host `db`.
# POSTGRES_USER="chatbot"
# POSTGRES_PASSWORD="chatbot"
# POSTGRES_DB="chatbot_dashboard"
# POSTGRES_PORT="5432"
# APP_PORT="3000"
