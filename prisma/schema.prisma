generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

enum TenantStatus {
  ACTIVE
  INACTIVE

  @@map("tenant_status")
}

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  difyAppId String @map("dify_app_id")
  difyApiKeyEncrypted String @map("dify_api_key_encrypted")
  difyApiBaseUrl      String? @map("dify_api_base_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKeys      ApiKey[]
  domains      DomainWhitelist[]
  widgetConfig WidgetConfig?
  logs         ConversationLog[]
  leads        Lead[]
  messengerChannel MessengerChannel?
  zaloChannel      ZaloChannel?

  @@map("tenants")
}

enum ApiKeyType {
  PUBLIC
  ADMIN

  @@map("api_key_type")
}

model ApiKey {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  keyValue String     @unique @map("key_value")
  label    String?
  type     ApiKeyType @default(PUBLIC)
  isActive Boolean    @default(true) @map("is_active")

  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([tenantId])
  @@map("api_keys")
}

model DomainWhitelist {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  domain    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, domain])
  @@index([tenantId])
  @@map("domain_whitelists")
}

enum WidgetMode {
  BUBBLE
  INLINE

  @@map("widget_mode")
}

enum WidgetPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT

  @@map("widget_position")
}

model WidgetConfig {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mode           WidgetMode     @default(BUBBLE)
  botName        String         @default("Trợ lý AI") @map("bot_name")
  logoUrl        String?        @map("logo_url")
  primaryColor   String         @default("#4F46E5") @map("primary_color")
  welcomeMessage String         @default("Xin chào! Tôi có thể giúp gì cho bạn?") @map("welcome_message")
  inputPlaceholder String       @default("Nhập câu hỏi của bạn...") @map("input_placeholder")
  position       WidgetPosition @default(BOTTOM_RIGHT)

  leadFormEnabled     Boolean @default(false) @map("lead_form_enabled")
  leadFormTitle       String  @default("Trước khi bắt đầu") @map("lead_form_title")
  leadFormDescription String  @default("Vui lòng để lại thông tin để chúng tôi tư vấn chính xác hơn.") @map("lead_form_description")
  leadFormSubmitLabel String  @default("Bắt đầu chat") @map("lead_form_submit_label")

  leadFormNameLabel  String @default("Họ và tên") @map("lead_form_name_label")
  leadFormPhoneLabel String @default("Số điện thoại") @map("lead_form_phone_label")

  leadFormFields Json @default("[]") @map("lead_form_fields")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("widget_configs")
}

model Lead {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName String @map("full_name")
  phone    String
  sessionId String  @map("session_id")
  pageUrl   String? @map("page_url")

  extra Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, sessionId])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model ConversationLog {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessionId       String  @map("session_id")
  difyConversationId String? @map("dify_conversation_id")
  requestPayload  Json    @map("request_payload")
  responsePayload Json    @map("response_payload")
  latencyMs       Int?    @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("conversation_logs")
}

model MessengerChannel {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pageId   String  @unique @map("page_id")
  pageName String? @map("page_name")
  pageAccessTokenEncrypted String @map("page_access_token_encrypted")
  isActive                 Boolean @default(true) @map("is_active")

  /// Khung giờ bot tự trả lời lại ban đêm, kể cả với hội thoại nhân viên đang
  /// giữ. Giờ theo Asia/Ho_Chi_Minh, 0-23. Khung qua nửa đêm (22 -> 6) hợp lệ.
  /// Cả hai cùng null = tắt tính năng. Không bao giờ sửa cờ `human_active` —
  /// hết khung giờ là hội thoại tự quay về trạng thái nhân viên giữ.
  nightResumeStartHour Int? @map("night_resume_start_hour")
  nightResumeEndHour   Int? @map("night_resume_end_hour")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations MessengerConversation[]

  @@map("messenger_channels")
}

model MessengerConversation {
  id        String           @id @default(cuid())
  channelId String           @map("channel_id")
  channel   MessengerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  psid               String
  difyConversationId String?  @map("dify_conversation_id")

  humanActive Boolean @default(false) @map("human_active")

  handoverAt DateTime? @map("handover_at")

  lastMessageAt      DateTime @default(now()) @map("last_message_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([channelId, psid])
  @@map("messenger_conversations")
}

model ZaloChannel {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  oaId   String  @unique @map("oa_id")
  oaName String? @map("oa_name")

  accessTokenEncrypted String?   @map("access_token_encrypted")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")

  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  refreshTokenUpdatedAt DateTime @map("refresh_token_updated_at")

  oaSecretKeyEncrypted String? @map("oa_secret_key_encrypted")

  lastRefreshError String? @map("last_refresh_error")

  isActive    Boolean   @default(true) @map("is_active")
  lastEventAt DateTime? @map("last_event_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations ZaloConversation[]

  @@map("zalo_channels")
}

model ZaloConversation {
  id        String      @id @default(cuid())
  channelId String      @map("channel_id")
  channel   ZaloChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  zaloUserId String @map("zalo_user_id")

  difyConversationId String?  @map("dify_conversation_id")
  lastMessageAt      DateTime @default(now()) @map("last_message_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([channelId, zaloUserId])
  @@index([channelId])
  @@map("zalo_conversations")
}
