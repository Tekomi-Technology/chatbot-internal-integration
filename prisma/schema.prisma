generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

enum TenantStatus {
  ACTIVE
  INACTIVE

  @@map("tenant_status")
}

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  difyAppId String @map("dify_app_id")
  difyApiKeyEncrypted String @map("dify_api_key_encrypted")
  difyApiBaseUrl      String? @map("dify_api_base_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKeys      ApiKey[]
  domains      DomainWhitelist[]
  widgetConfig WidgetConfig?
  logs         ConversationLog[]
  messengerChannel MessengerChannel?

  @@map("tenants")
}

enum ApiKeyType {
  PUBLIC
  ADMIN

  @@map("api_key_type")
}

model ApiKey {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  keyValue String     @unique @map("key_value")
  label    String?
  type     ApiKeyType @default(PUBLIC)
  isActive Boolean    @default(true) @map("is_active")

  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([tenantId])
  @@map("api_keys")
}

model DomainWhitelist {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  domain    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, domain])
  @@index([tenantId])
  @@map("domain_whitelists")
}

enum WidgetMode {
  BUBBLE
  INLINE

  @@map("widget_mode")
}

enum WidgetPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT

  @@map("widget_position")
}

model WidgetConfig {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mode           WidgetMode     @default(BUBBLE)
  botName        String         @default("Trợ lý AI") @map("bot_name")
  logoUrl        String?        @map("logo_url")
  primaryColor   String         @default("#4F46E5") @map("primary_color")
  welcomeMessage String         @default("Xin chào! Tôi có thể giúp gì cho bạn?") @map("welcome_message")
  inputPlaceholder String       @default("Nhập câu hỏi của bạn...") @map("input_placeholder")
  position       WidgetPosition @default(BOTTOM_RIGHT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("widget_configs")
}

model ConversationLog {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessionId       String  @map("session_id")
  difyConversationId String? @map("dify_conversation_id")
  requestPayload  Json    @map("request_payload")
  responsePayload Json    @map("response_payload")
  latencyMs       Int?    @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("conversation_logs")
}

model MessengerChannel {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pageId   String  @unique @map("page_id")
  pageName String? @map("page_name")
  pageAccessTokenEncrypted String @map("page_access_token_encrypted")
  isActive                 Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations MessengerConversation[]

  @@map("messenger_channels")
}

model MessengerConversation {
  id        String           @id @default(cuid())
  channelId String           @map("channel_id")
  channel   MessengerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Page-Scoped ID: chỉ có ý nghĩa trong phạm vi đúng page đó.
  psid               String
  difyConversationId String?  @map("dify_conversation_id")
  lastMessageAt      DateTime @default(now()) @map("last_message_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([channelId, psid])
  @@map("messenger_conversations")
}
